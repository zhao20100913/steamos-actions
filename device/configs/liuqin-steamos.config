# liuqin-steamos.config —— SteamOS（holo）移植专用内核片段
#
# 目标：无 initramfs、内核直接挂根。必须内建三件事：UFS（根块设备）、ext4（根文件系统）、
# devtmpfs（/dev 设备节点）。另外把 uinput 置 y（uinput 是 misc 设备，没有 modalias，
# 模块方式无法自动加载；SteamOS 上虚拟输入/手写笔等用户态方案会用到）。
#
# 用法：作为最后一个片段叠加到 xiaomipad-6pro-mainline 的片段之后（顺序见
# kernel/source.json 的 config_fragments），由 scripts/host/07-build-liuqin-kernel.sh
# 自动完成 defconfig -> merge_config.sh -m -> olddefconfig。
#
# 说明：这些选项大部分在 arm64 defconfig 里已是 =y（EXT4/DEVTMPFS），这里显式固定，
# 防止上游改动回退；UFS 在 defconfig 里是 =m，必须改 =y。

CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y

# UFS（SM8475 的内置存储走 UFS）：=y 才能在 initramfs 之前找到根设备
CONFIG_SCSI=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y

# /dev 与首启设备节点
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# 虚拟输入设备（uinput）内建
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y

# 内核直接挂根时 cmdline 用 root=PARTLABEL= 解析，依赖块层分区标签匹配（默认内建，无需单独开关）
